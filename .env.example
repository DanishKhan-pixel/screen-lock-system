# Copy to .env and adjust for your machine

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=aegis
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-before-going-to-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ── Screen lock ───────────────────────────────────────────────────────────────
# Maximum consecutive incorrect PIN attempts before the session is logged out.
# Defaults to 3 if not set.
SCREEN_LOCK_MAX_ATTEMPTS=3
